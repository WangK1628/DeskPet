{
  "name": "guoba-tegong-deskpet",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + React + TypeScript Live2D desktop pet themed by fruit heroes",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 dist-electron/main.js && electron .\"",
    "build": "vite build && npm run build:main",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "predev": "npm run build:main",
    "build:main": "tsc -p electron/tsconfig.json",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "postinstall": "npm run build:main"
    "dist:win": "npm run build && electron-builder --win nsis",
    "postinstall": "npm run build:main"
    "build": "vite build && tsc -p electron/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "predev": "tsc -p electron/tsconfig.json"
  },
  "dependencies": {
    "pixi.js": "^7.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "pixi-live2d-display": "^0.5.0-beta"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^31.7.7",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "wait-on": "^8.0.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.guoba.deskpet",
    "productName": "DeskPet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
